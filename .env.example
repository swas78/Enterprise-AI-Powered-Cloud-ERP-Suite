# ── Database ────────────────────────────────────────────────
DB_USER=postgres
DB_HOST=localhost
DB_NAME=erp_db
DB_PASSWORD=your_postgres_password
DB_PORT=5432

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=24h

# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
