# ==========================================
# Amdox ERP - Environmental Configuration
# Copy this file to .env and customize values
# ==========================================

# General Configuration
PORT=5000
NODE_ENV=development
API_VERSION=v1

# Database Configuration
# MongoDB connection string (Replica set URI is recommended for transactions)
DATABASE_URL=mongodb://localhost:27017/amdox-erp?replicaSet=rs0

# Redis Cache & Queue Configuration
REDIS_URL=redis://localhost:6379

# Authentication & Keycloak SSO
JWT_SECRET=super-secret-jwt-key-replace-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
KEYCLOAK_REALM=amdox-erp
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8080/
KEYCLOAK_CLIENT_ID=amdox-erp-client
KEYCLOAK_CLIENT_SECRET=keycloak-client-secret-here

# Email Notification Configuration (AWS SES)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
EMAIL_FROM=notifications@amdox.com

# External AI Forecasting Microservice
ML_SERVICE_URL=http://localhost:8000

# File Storage Configuration (AWS S3 or Local Mock)
STORAGE_BUCKET=amdox-erp-files
