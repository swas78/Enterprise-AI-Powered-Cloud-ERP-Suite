{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JournalEntry",
  "type": "object",
  "properties": {
    "_id": { "type": "string", "pattern": "^[0-9a-fA-F]{24}$" },
    "tenantId": { "type": "string", "pattern": "^[0-9a-fA-F]{24}$" },
    "ref": { "type": "string" },
    "description": { "type": "string" },
    "date": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["Draft", "Posted"] },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "accountId": { "type": "string", "pattern": "^[0-9a-fA-F]{24}$" },
          "accountName": { "type": "string" },
          "type": { "type": "string", "enum": ["Debit", "Credit"] },
          "amount": { "type": "number", "minimum": 0 }
        },
        "required": ["accountId", "accountName", "type", "amount"]
      }
    }
  },
  "required": ["tenantId", "ref", "date", "status", "lines"]
}
