{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Role",
  "type": "object",
  "properties": {
    "_id": { "type": "string", "pattern": "^[0-9a-fA-F]{24}$" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "permissions": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["name", "permissions"]
}
