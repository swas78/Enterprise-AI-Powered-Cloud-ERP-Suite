{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Inventory",
  "type": "object",
  "properties": {
    "_id": { "type": "string", "pattern": "^[0-9a-fA-F]{24}$" },
    "tenantId": { "type": "string", "pattern": "^[0-9a-fA-F]{24}$" },
    "sku": { "type": "string" },
    "description": { "type": "string" },
    "quantityOnHand": { "type": "number", "minimum": 0 },
    "safetyStock": { "type": "number", "minimum": 0 },
    "reorderPoint": { "type": "number", "minimum": 0 },
    "reorderQuantity": { "type": "number", "minimum": 0 },
    "costPrice": { "type": "number", "minimum": 0 },
    "sellingPrice": { "type": "number", "minimum": 0 }
  },
  "required": ["tenantId", "sku", "quantityOnHand", "safetyStock", "reorderPoint", "reorderQuantity", "costPrice"]
}
